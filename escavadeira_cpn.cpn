<workspaceElements><generator tool="CPN Tools" version="4.0.1" format="6"/><cpnet><globbox><block id="ID1020"><id>Standard declarations</id><color id="ID1000"><id>UNIT</id><unit/><layout>colset UNIT = unit;</layout></color><color id="ID1001"><id>BOOL</id><bool/><layout>colset BOOL = bool;</layout></color><color id="ID1002"><id>INT</id><int/><layout>colset INT = int;</layout></color><color id="ID1003"><id>STRING</id><string/><layout>colset STRING = string;</layout></color></block><block id="ID1021"><id>Escavadeira</id><color id="ID1004"><id>ESTADO</id><enum><id>Desarmada</id><id>Armada</id><id>Parada</id><id>BateriaBaixa</id></enum><layout>colset ESTADO = with Desarmada | Armada | Parada | BateriaBaixa;</layout></color><color id="ID1005"><id>POSEID</id><int><with><ml>0</ml><ml>5</ml></with></int><layout>colset POSEID = int with 0..5;</layout></color><color id="ID1006"><id>DRV</id><product><id>INT</id><id>INT</id></product><layout>colset DRV = product INT * INT;</layout></color><color id="ID1007"><id>CMD</id><union><unionfield><id>U</id></unionfield><unionfield><id>M</id></unionfield><unionfield><id>S</id></unionfield><unionfield><id>G</id><type><id>POSEID</id></type></unionfield><unionfield><id>D</id><type><id>DRV</id></type></unionfield></union><layout>colset CMD = union U + M + S + G:POSEID + D:DRV;</layout></color><color id="ID1008"><id>CMDS</id><list><id>CMD</id></list><layout>colset CMDS = list CMD;</layout></color><color id="ID1009"><id>POSE</id><product><id>INT</id><id>INT</id><id>INT</id><id>INT</id></product><layout>colset POSE = product INT * INT * INT * INT;</layout></color><color id="ID1010"><id>RESPS</id><list><id>STRING</id></list><layout>colset RESPS = list STRING;</layout></color><var id="ID1011"><type><id>ESTADO</id></type><id>e</id><layout>var e : ESTADO;</layout></var><var id="ID1012"><type><id>CMDS</id></type><id>cs</id><layout>var cs : CMDS;</layout></var><var id="ID1013"><type><id>POSEID</id></type><id>n</id><layout>var n : POSEID;</layout></var><var id="ID1014"><type><id>POSE</id></type><id>q</id><layout>var q : POSE;</layout></var><var id="ID1015"><type><id>INT</id></type><id>f</id><id>k</id><id>mv</id><layout>var f, k, mv : INT;</layout></var><var id="ID1016"><type><id>DRV</id></type><id>r</id><layout>var r : DRV;</layout></var><var id="ID1017"><type><id>RESPS</id></type><id>rs</id><layout>var rs : RESPS;</layout></var><ml id="ID1018">fun preset (n:int) : POSE =
  case n of
    0 =&gt; (0, ~35, 0, 0)        (* Transporte *)
  | 1 =&gt; (0, ~20, ~35, ~20)    (* Trabalho *)
  | 2 =&gt; (0, 30, ~80, 0)       (* Cavar *)
  | 3 =&gt; (0, ~35, ~35, 50)     (* Carregar *)
  | 4 =&gt; (0, ~35, ~70, ~60)    (* Despejar *)
  | _ =&gt; (0, 36, ~126, 0);     (* Alcance *)<layout>fun preset (n:int) : POSE =
  case n of
    0 =&gt; (0, ~35, 0, 0)        (* Transporte *)
  | 1 =&gt; (0, ~20, ~35, ~20)    (* Trabalho *)
  | 2 =&gt; (0, 30, ~80, 0)       (* Cavar *)
  | 3 =&gt; (0, ~35, ~35, 50)     (* Carregar *)
  | 4 =&gt; (0, ~35, ~70, ~60)    (* Despejar *)
  | _ =&gt; (0, 36, ~126, 0);     (* Alcance *)</layout></ml><ml id="ID1019">fun aplicaPose (n:int, (g, _, _, _) : POSE) : POSE =
  let val (_, l, b, c) = preset n in (g, l, b, c) end;<layout>fun aplicaPose (n:int, (g, _, _, _) : POSE) : POSE =
  let val (_, l, b, c) = preset n in (g, l, b, c) end;</layout></ml></block></globbox><page id="ID1247"><pageattr name="Controlador_Escavadeira"/><place id="ID1022"><posattr x="-508.000000" y="109.600000"/><fillattr colour="White" pattern="" filled="false"/><lineattr colour="Black" thick="1" type="Solid"/><textattr colour="Black" bold="false"/><text>Fila_Comandos</text><ellipse w="110.000000" h="44.000000"/><token x="-10.000000" y="0.000000"/><marking x="0.000000" y="0.000000" hidden="false"/><type id="ID1041"><posattr x="-448.000000" y="77.600000"/><fillattr colour="White" pattern="Solid" filled="false"/><lineattr colour="Black" thick="0" type="Solid"/><textattr colour="Black" bold="false"/><text tool="CPN Tools" version="4.0.1">CMDS</text></type><initmark id="ID1042"><posattr x="-438.000000" y="143.600000"/><fillattr colour="White" pattern="Solid" filled="false"/><lineattr colour="Black" thick="0" type="Solid"/><textattr colour="Black" bold="false"/><text tool="CPN Tools" version="4.0.1">1`[U, G(2), D(60,0), S, U, G(4), M]</text></initmark></place><place id="ID1023"><posattr x="-508.000000" y="-178.400000"/><fillattr colour="White" pattern="" filled="false"/><lineattr colour="Black" thick="1" type="Solid"/><textattr colour="Black" bold="false"/><text>Respostas</text><ellipse w="110.000000" h="44.000000"/><token x="-10.000000" y="0.000000"/><marking x="0.000000" y="0.000000" hidden="false"/><type id="ID1043"><posattr x="-448.000000" y="-210.400000"/><fillattr colour="White" pattern="Solid" filled="false"/><lineattr colour="Black" thick="0" type="Solid"/><textattr colour="Black" bold="false"/><text tool="CPN Tools" version="4.0.1">RESPS</text></type><initmark id="ID1044"><posattr x="-438.000000" y="-144.400000"/><fillattr colour="White" pattern="Solid" filled="false"/><lineattr colour="Black" thick="0" type="Solid"/><textattr colour="Black" bold="false"/><text tool="CPN Tools" version="4.0.1">1`[]</text></initmark></place><place id="ID1024"><posattr x="-60.000000" y