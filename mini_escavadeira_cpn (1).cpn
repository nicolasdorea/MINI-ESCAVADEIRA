        <ml id="ID1412324040">fun validarColeta(d : DISTANCIA) : bool = (d &gt; 2 andalso d &lt;= 12);
          <layout>fun validarColeta(d : DISTANCIA) : bool = (d &gt; 2 andalso d &lt;= 12);</layout>
        </ml>
        <ml id="ID1412324248">fun calcularPostura(etapa : string) : ESTADO_ATUADORES =
  if etapa = &quot;COLETA&quot; then (45, 110, 130, 30)
  else if etapa = &quot;RECOLHER&quot; then (45, 110, 130, 120)
  else if etapa = &quot;ELEVAR&quot; then (45, 60, 90, 120)
  else if etapa = &quot;DESCARGA&quot; then (135, 75, 100, 30)
  else (90, 90, 90, 30);
          <layout>fun calcularPostura(etapa : string) : ESTADO_ATUADORES =
  if etapa = &quot;COLETA&quot; then (45, 110, 130, 30)
  else if etapa = &quot;RECOLHER&quot; then (45, 110, 130, 120)
  else if etapa = &quot;ELEVAR&quot; then (45, 60, 90, 120)
  else if etapa = &quot;DESCARGA&quot; then (135, 75, 100, 30)
  else (90, 90, 90, 30);</layout>
        </ml>
        <ml id="ID1412339734">fun posturaMovimento(m : string) : ESTADO_ATUADORES =
  if m = &quot;GIRO_COLETA&quot; then (45, 90, 90, 30)
  else if m = &quot;BAIXAR_LANCA&quot; then (45, 110, 90, 30)
  else if m = &quot;ESTENDER_BRACO&quot; then (45, 110, 130, 30)
  else if m = &quot;FECHAR_CACAMBA&quot; then (45, 110, 130, 120)
  else if m = &quot;ABRIR_CACAMBA&quot; then (135, 75, 100, 25)
  else (90, 90, 90, 30);
          <layout>fun posturaMovimento(m : string) : ESTADO_ATUADORES =
  if m = &quot;GIRO_COLETA&quot; then (45, 90, 90, 30)
  else if m = &quot;BAIXAR_LANCA&quot; then (45, 110, 90, 30)
  else if m = &quot;ESTENDER_BRACO&quot; then (45, 110, 130, 30)
  else if m = &quot;FECHAR_CACAMBA&quot; then (45, 110, 130, 120)
  else if m = &quot;ABRIR_CACAMBA&quot; then (135, 75, 100, 25)
  else (90, 90, 90, 30);</layout>
        </ml>
      </block>
